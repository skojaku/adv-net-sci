# Copy to .env on the VM. Never commit the filled-in version.
# systemd reads this via EnvironmentFile=.

# Ollama. Two ways to run this, pick one and set OLLAMA_BASE_URL to match:
#   (a) hosted:  https://ollama.com/v1     + an API key from ollama.com
#   (b) local daemon signed in to the same account, which forwards ":cloud"
#       models upstream:  http://127.0.0.1:11434/v1  + any placeholder key
OLLAMA_API_KEY=

# OpenRouter, used as the fallback and for anything Ollama does not serve.
OPENROUTER_API_KEY=

# Where the SQLite ledger lives. Must be on a persistent disk.
GATEWAY_DB=/var/lib/llm-gateway/gateway.db

# Path to the real (uncommitted) alias mapping.
GATEWAY_CONFIG=/etc/llm-gateway/config.yaml
