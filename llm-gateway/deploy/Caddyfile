# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the gateway on
# loopback. Replace the hostname with the VM's DNS name before installing.
#
# Students hit https://llm.example.edu/v1/... ; the gateway itself never binds
# a public interface.

llm.example.edu {
	encode zstd gzip

	# Streamed completions must not be buffered, or students watch a blank
	# screen and then get the whole answer at once.
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		transport http {
			response_header_timeout 10m
		}
	}

	# One line per request, without bodies.
	log {
		output file /var/log/caddy/llm-gateway.log
		format json
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
