# ---------------------------------------------------------------------------
# Rule of thumb: if a script or a build command can produce it, it does not
# belong in git. Sources only.
# ---------------------------------------------------------------------------

# --- Quarto / lecture note build output ------------------------------------
lecture-note/_site/
lecture-note/_freeze/
lecture-note/site_libs/
lecture-note/_book/
lecture-note/.quarto/
lecture-note/**/__marimo__/
/.quarto/
/_site/
_book/

# Figures built by tools/build_figures.sh from lecture-note/figs/src/*.py.
# Everything else in figs/ is hand-made art with no generator — keep it.
lecture-note/figs/*.svg

# --- Slides -----------------------------------------------------------------
# Marp/Quarto renders, review screenshot sweeps, and script-built figures.
# The .md under review/ are design specs and fix logs — those are sources.
slides/**/review/*.png
slides/**/review/*.json
slides/**/review/small/
slides/**/*_files/
slides/**/figures/*.png
slides/**/figures/*.gif
slides/**/figures/*.svg
slides/**/figures/data/
# ...but these are hand-placed photographs and portraits with no generator.
!slides/intro/figures/flue-01.png
!slides/intro/figures/flue-02.png
!slides/intro/figures/xkcd_dependency.png
!slides/m01/figures/konigsberg-map.png
!slides/m01/figures/connected-component.jpg
!slides/m02/figures/milgram-route.png
!slides/m02/figures/six-degrees-poster.jpg
!slides/m03/figures/boruvka-portrait.png

# --- LaTeX ------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.bcf
*.synctex.gz
*.toc
*blx.bib
*.fls
*.fdb_latexmk
*.out
*.run.xml
*.log
*.xdv

# --- Binaries and data ------------------------------------------------------
# Worksheet and syllabus PDFs are force-added (`git add -f`); they are the
# artifact students download and nothing in CI rebuilds them.
*.pdf
*.csv
*.tsv
*.txt
*.docx
*.doc
*.ppt
*.pptx
*.xls
*.xlsx
*.bin
*.bin.gz
*.gz
*.zip

# --- Pair Notebook sessions run in this repo ---------------------------------------
# The module folders under tutor-prototype/ are the authoring copies of what
# students clone. Their own .gitignore keeps the session artifacts TRACKED —
# for a student those files are the submission — so the ignoring has to happen
# here instead, or every test run of a session lands in this repo.
tutor-prototype/*/notebook.py
tutor-prototype/*/session_artifacts/
tutor-prototype/*/assets/uploads/
tutor-prototype/*/assets/exercises/
tutor-prototype/*/.pi/git/
tutor-prototype/*/.pi/npm/

# --- Local scratch ----------------------------------------------------------
assignments/
tmp/
tools/tmp/
lecture-note/tmp*
.venv-figs/
marimo.toml
.snakemake
workflow/config.yaml
*.bak
*.un~
.DS_Store

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
*.egg-info/
*.egg
.installed.cfg
.ipynb_checkpoints/
.tox/
.coverage
.coverage.*
.cache
htmlcov/
coverage.xml
nosetests.xml

# Brightspace upload images: `convert -density 300 quiz_slides.pdf images/output_%d.jpg`
# (see exam/README.md). Regenerated from quiz.json whenever the quiz changes.
exam/images/
exam/sampler-quiz-images/
